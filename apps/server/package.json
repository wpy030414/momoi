{
  "name": "@momoi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:standalone": "cross-env NODE_ENV=development tsx watch src/index.ts --stand-alone",
    "build": "vp pack && node scripts/copy-docs.mjs",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:standalone": "cross-env NODE_ENV=production node dist/index.js --stand-alone",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "check": "vp check --no-fmt"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@homurajs/db": "26.10.14",
    "@hono/node-server": "^1.19.17",
    "@momoi/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "adm-zip": "^0.6.0",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "1.0.0-rc.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "playwright-core": "1.64.1",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "word-extractor": "^1.0.4",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.17.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite-plus": "^1.4.0"
  },
  "optionalDependencies": {
    "pg": "^8.23.0"
  }
