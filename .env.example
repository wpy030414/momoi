# ===== 管理员（用户名名单，逗号分隔；留空/缺省 = 无管理员） =====
ADMIN=xrl

# ===== JWT 签名密钥（可选；缺省时首启自动生成并持久化到数据库） =====
# JWT_SECRET=

# ===== AI 模型（OpenAI 兼容 API） =====
OPENAI_BASE_URL=http://router.xrl.im/v1
OPENAI_API_KEY=xrl-router-secret
OPENAI_MODEL=deepseek-v4.1-flash

# ===== 服务端口 =====
PORT=11408

# ===== 远程数据库（可选；三者同时填写才启用，缺省使用本地 node:sqlite）=====
# 系统从 URL scheme 自动识别数据库类型：
#   postgres:// 或 postgresql:// → PostgreSQL
# DATABASE_URL=postgres://localhost:5432/momoi
# DATABASE_USER=momoi
# DATABASE_SECRET=your-password

# ===== WorkBuddy 上游（可选；仅协议适配需要时覆盖，通常无需填写） =====
# 后台「网关 → 上游类型」选择 WorkBuddy 时，服务端用网页登录换票并自动轮换。
# 登录页默认展示微信扫码：服务端用纯 HTTP 链路取到二维码回传到凭证面板。
# 下面的值只在 WorkBuddy 客户端升级、网关地址或客户端版本校验变化时才需要调整。
# WORKBUDDY_BASE_URL=https://copilot.tencent.com
# WORKBUDDY_AUTH_BASE_URL=https://www.workbuddy.cn
# WORKBUDDY_DOMAIN=www.workbuddy.cn
# WORKBUDDY_IDE_VERSION=5.8.3
# WORKBUDDY_MODELS_PATH=/v2/enterprises/personal/models
# WORKBUDDY_REFRESH_AHEAD_MS=300000
# WORKBUDDY_KEEPALIVE_MS=60000
# WORKBUDDY_QR_WAIT_MS=30000
# Keycloak 登录网关（纯 HTTP 扫码）：realm / client_id 变了才需要调整
# WORKBUDDY_REALM=copilot
# WORKBUDDY_CONSOLE_CLIENT_ID=console
# WORKBUDDY_WECHAT_CLIENT_ID=login
# WORKBUDDY_WECHAT_IDP_HINT=weixinwebchat

# ===== 豆包（Doubao）上游（可选；仅协议适配需要时覆盖，通常无需填写） =====
# 后台「网关 → 上游类型」选择豆包后，在凭证面板扫码登录即可。
# 默认 DOUBAO_LOGIN_FLOW=douyin：纯 HTTP 走账号 SDK 取抖音扫码二维码（无需服务器浏览器）。
# 设 DOUBAO_LOGIN_FLOW=doubao 改用豆包 App 自助扫码码（应急旁路，二维码不同）。
# DOUBAO_LOGIN_FLOW=douyin
# DOUBAO_LOGIN_REQUEST_TIMEOUT_MS=20000
# 抖音开放平台 OAuth（默认登录链路）：client_key / 回调地址变了才需要调整
# DOUBAO_DOUYIN_CLIENT_KEY=aw4293rjg7ggbx9m
# DOUBAO_DOUYIN_CALLBACK_URL=https://www.doubao.com/auth/callback
# DOUBAO_DOUYIN_AID=1128
# DOUBAO_DOUYIN_SDK_VERSION=1.0.13
# DOUBAO_BASE_URL=https://www.doubao.com
# DOUBAO_AUTH_BASE_URL=https://www.doubao.com
# DOUBAO_AID=497858
# DOUBAO_PC_VERSION=3.42.5
# DOUBAO_BOT_ID=7338286299411103781
# DOUBAO_CHAT_MODE=auto
# DOUBAO_LOGIN_POLL_MS=1500
# DOUBAO_LOGIN_TIMEOUT_MS=300000
# 后台凭证巡检：豆包没有 refresh token，巡检只探测有效性并吸收上游轮换的 Cookie
# DOUBAO_KEEPALIVE_MS=900000
# DOUBAO_KEEPALIVE_TIMEOUT_MS=15000
# 灾备 Cookie（等同账号密码，仅建议临时使用；正常请走扫码登录）
# DOUBAO_COOKIES=
# DOUBAO_UID=
# DOUBAO_DEVICE_ID=
# DOUBAO_WEB_ID=
# DOUBAO_FP=
# 附件上传（ImageX）与每轮会话清理
# DOUBAO_UPLOAD=1
# DOUBAO_MAX_ATTACHMENT_MB=20
# DOUBAO_MAX_ATTACHMENTS=10
# DOUBAO_ALLOW_PRIVATE_URLS=0
# DOUBAO_UPLOAD_TIMEOUT_MS=120000
# DOUBAO_AUTO_DELETE_CONVERSATION=1
# DOUBAO_CLEANUP_TIMEOUT_MS=10000
# DOUBAO_THINKING_SUMMARY=1
# DOUBAO_DEBUG=0
