# ===== 管理员（用户名名单，逗号分隔；留空/缺省 = 无管理员） =====
ADMIN=xrl

# ===== JWT 签名密钥（可选；缺省时首启自动生成并持久化到数据库） =====
# JWT_SECRET=

# ===== AI 模型（OpenAI 兼容 API） =====
OPENAI_BASE_URL=http://router.xrl.im/v1
OPENAI_API_KEY=xrl-router-secret
OPENAI_MODEL=deepseek-v4.1-flash

# ===== 服务端口 =====
PORT=11408

# ===== 远程数据库（可选；三者同时填写才启用，缺省使用本地 node:sqlite）=====
# 系统从 URL scheme 自动识别数据库类型：
#   postgres:// 或 postgresql:// → PostgreSQL
# DATABASE_URL=postgres://localhost:5432/momoi
# DATABASE_USER=momoi
# DATABASE_SECRET=your-password

# ===== WorkBuddy 上游（可选；仅协议适配需要时覆盖，通常无需填写） =====
# 后台「网关 → 上游类型」选择 WorkBuddy 时，服务端用网页登录换票并自动轮换。
# 登录页默认展示微信扫码：服务端用纯 HTTP 链路取到二维码回传到凭证面板。
# 下面的值只在 WorkBuddy 客户端升级、网关地址或客户端版本校验变化时才需要调整。
# WORKBUDDY_BASE_URL=https://copilot.tencent.com
# WORKBUDDY_AUTH_BASE_URL=https://www.workbuddy.cn
# WORKBUDDY_DOMAIN=www.workbuddy.cn
# WORKBUDDY_IDE_VERSION=5.8.3
# WORKBUDDY_MODELS_PATH=/v2/enterprises/personal/models
# WORKBUDDY_REFRESH_AHEAD_MS=300000
# WORKBUDDY_KEEPALIVE_MS=60000
# WORKBUDDY_QR_WAIT_MS=30000
# Keycloak 登录网关（纯 HTTP 扫码）：realm / client_id 变了才需要调整
# WORKBUDDY_REALM=copilot
# WORKBUDDY_CONSOLE_CLIENT_ID=console
# WORKBUDDY_WECHAT_CLIENT_ID=login
# WORKBUDDY_WECHAT_IDP_HINT=weixinwebchat
